#!/bin/bash
# ==============================================================================
# 99-lrp-setup.chroot — LRP OS Appliance chroot configuration hook
# ==============================================================================
set -euo pipefail

echo "[LRP-CHROOT-HOOK] Configuring LRP OS Appliance environment..."

# 0. isofs en el initramfs: el USB grabado en modo DD es ISO9660 puro y
# live-boot no puede montarlo sin el modulo. CONFIG_ISO9660_FS compila
# fs/isofs/isofs.ko (no existe un modulo llamado "iso9660").
# Sin esto: "Unable to find a medium containing a live file system".
mkdir -p /etc/initramfs-tools
touch /etc/initramfs-tools/modules
for mod in isofs vfat; do
    if ! grep -qx "$mod" /etc/initramfs-tools/modules; then
        echo "$mod" >> /etc/initramfs-tools/modules
    fi
done
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all >/var/log/lrp-initramfs.log 2>&1 || \
        echo "WARN: update-initramfs fallo; revisar /var/log/lrp-initramfs.log" >>/var/log/lrp-initramfs.log
fi

# 1. Ensure lrp system user exists
if ! id -u lrp >/dev/null 2>&1; then
    echo "[LRP-CHROOT-HOOK] Creating user 'lrp'..."
    useradd -m -s /bin/bash -U lrp
    echo "lrp:lrp" | chpasswd
fi

# Add lrp to essential hardware and management groups
for grp in sudo audio video input render netdev dialout; do
    if getent group "$grp" >/dev/null 2>&1; then
        usermod -aG "$grp" lrp
    fi
done

# Passwordless sudo for lrp
mkdir -p /etc/sudoers.d
echo "lrp ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/99-lrp-user
chmod 0440 /etc/sudoers.d/99-lrp-user

# 2. Appliance session: sin display manager. Autologin de getty en tty1 +
# startx/openbox. LightDM queda enmascarado para que nunca muestre un greeter.
# live-config se enmascara: en el arranque real reescribe el autologin de tty1
# con su usuario 'user', que no existe en esta imagen, y deja "Authentication
# failure" en consola. La configuracion de usuario/sesion es nuestra.
systemctl disable lightdm.service >>/var/log/lrp-chroot-hook.log 2>&1 || true
systemctl mask lightdm.service >>/var/log/lrp-chroot-hook.log 2>&1 || true
systemctl mask live-config.service live-tools.service >>/var/log/lrp-chroot-hook.log 2>&1 || true

mkdir -p /etc/systemd/system/getty@tty1.service.d
cat <<'EOF' > /etc/systemd/system/getty@tty1.service.d/autologin.conf
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin lrp --noclear %I $TERM
EOF

cat <<'EOF' > /home/lrp/.bash_profile
# LRP appliance: tty1 arranca la sesion grafica automaticamente.
if [ -z "${DISPLAY:-}" ] && [ "$(tty 2>/dev/null)" = "/dev/tty1" ]; then
    exec startx -- -nocursor
fi
EOF

cat <<'EOF' > /home/lrp/.xinitrc
#!/bin/sh
xset s off -dpms 2>/dev/null || true
exec openbox-session
EOF
chmod +x /home/lrp/.xinitrc
chown lrp:lrp /home/lrp/.bash_profile /home/lrp/.xinitrc

# 3. Openbox session defaults
mkdir -p /home/lrp/.config/openbox
cat <<'EOF' > /home/lrp/.config/openbox/autostart
# TV appliance: no screensaver, no DPMS blank
xset s off -dpms 2>/dev/null || true
EOF
chown -R lrp:lrp /home/lrp/.config

# 4. Configure zram-generator
cat <<EOF > /etc/systemd/zram-generator.conf
[zram0]
zram-size = min(ram / 2, 4096)
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF

# 5. Install LRP deb staged at /opt/lrp-stage/lrp.deb and create the backend unit
STAGE=/opt/lrp-stage/lrp.deb
LOG=/var/log/lrp-chroot-hook.log
: > "$LOG"
if [ -f "$STAGE" ]; then
    echo "[LRP-CHROOT-HOOK] Installing staged linuxremoteplayer.deb package..."
    apt-get update -qq >>"$LOG" 2>&1 || true
    if ! apt-get install -y "$STAGE" >>"$LOG" 2>&1; then
        dpkg -i "$STAGE" >>"$LOG" 2>&1 || true
        apt-get install -f -y >>"$LOG" 2>&1 || true
    fi
    rm -f "$STAGE"
else
    echo "WARN: $STAGE no estaba presente; la ISO no llevara el backend." >>"$LOG"
fi

if [ -x /opt/linuxremoteplayer/backend/.venv/bin/python ]; then
    echo "[LRP-CHROOT-HOOK] Backend venv detected; wiring systemd unit."
    install -d -o lrp -g lrp -m 0755 /var/lib/linuxremoteplayer
    cat <<EOF > /etc/systemd/system/linuxremoteplayer.service
[Unit]
Description=Linux Remote Player Backend API
Wants=network-online.target
After=display-manager.service network-online.target

[Service]
Type=simple
User=lrp
WorkingDirectory=/opt/linuxremoteplayer/backend
Environment="APPLIANCE_IDLE_PANEL=true"
Environment="DISPLAY=:0"
ExecStart=/opt/linuxremoteplayer/backend/.venv/bin/python run.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
EOF
    mkdir -p /etc/systemd/system/graphical.target.wants
    ln -sf /etc/systemd/system/linuxremoteplayer.service \
        /etc/systemd/system/graphical.target.wants/linuxremoteplayer.service
    systemctl enable linuxremoteplayer.service >>"$LOG" 2>&1 || true

    # uinput para touchpad/teclado virtuales: sin esta regla /dev/uinput queda 0600
    # root:root y el backend no puede inyectar entrada en la sesion live.
    cat <<'EOF' > /etc/udev/rules.d/99-linuxremoteplayer-uinput.rules
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"
EOF
    echo uinput > /etc/modules-load.d/lrp-uinput.conf
else
    echo "WARN: venv del backend ausente; revisar postinst del .deb (sin red en build?)." >>"$LOG"
fi

# 6. Install automated installer service (triggered if booted with lrp_auto_install kernel param)
if [ -f /usr/local/sbin/lrp-install-target.sh ]; then
    chmod +x /usr/local/sbin/lrp-install-target.sh
    cat <<EOF > /etc/systemd/system/lrp-auto-install.service
[Unit]
Description=LRP OS Automated Live-to-Disk Installer
ConditionKernelCommandLine=lrp_auto_install
After=multi-user.target
Before=getty.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lrp-install-target.sh --force-confirm
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
EOF
    systemctl enable lrp-auto-install.service 2>/dev/null || true
fi

echo "[LRP-CHROOT-HOOK] LRP OS Appliance chroot configuration finished."
