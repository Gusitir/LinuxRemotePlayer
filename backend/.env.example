# Local voice preference (privacy switch). PH24: no license, token or quota is
# involved; the pipeline runs 100% on the appliance. Users can turn it off here.
ENABLE_VOICE=true

# Access control: shared pairing token. Empty = auto-generated on first boot and
# stored in .pairing_token.
PAIRING_TOKEN=

# Keyboard layout for the UInput emulator. Valid: us | es | latam (default: us)
# Note for es/latam: < and > require KEY_102ND. Brackets/braces via AltGr not covered.
KEYBOARD_LAYOUT=us

# Developer mode. Leave false/unset on any real installation: setting it to true exposes
# the auto-generated API docs (/docs, /redoc, /openapi.json) with NO authentication to
# anyone on the local network.
LRP_DEV=false
