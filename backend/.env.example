# Voice / AI master switch. Lo enciende SOLO la activacion de una licencia Pro, y el
# usuario puede apagarlo desde Ajustes. No hace falta tocarlo a mano.
ENABLE_VOICE=false

# --- Voice AI proxy ---
# Optional override (default shown):
# AI_PROXY_URL=https://tbijfdbtauzxbsbkujbs.functions.supabase.co/ai-proxy

# Access control: shared pairing token used when Supabase is OFF.
PAIRING_TOKEN=

# --- Commercialization / licensing ---
LICENSE_API_URL=https://tbijfdbtauzxbsbkujbs.functions.supabase.co/validate-license
LICENSE_TOKEN=
GITHUB_REPO=Gusitir/LinuxRemotePlayer
# NOTE: se reemplaza por la URL de Paddle al dar de alta el producto.
BUY_URL=https://www.linuxremoteplayer.com/

# Keyboard layout for the UInput emulator. Valid: us | es | latam (default: us)
# Note for es/latam: < and > require KEY_102ND. Brackets/braces via AltGr not covered.
KEYBOARD_LAYOUT=us

# Developer mode. Leave false/unset on any real installation: setting it to true exposes
# the auto-generated API docs (/docs, /redoc, /openapi.json) with NO authentication to
# anyone on the local network.
LRP_DEV=false
